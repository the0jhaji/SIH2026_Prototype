# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo
dataset/roboflow/
# Python
.venv/
backend/venv/
__pycache__/
*.pyc
.pytest_cache/

# Model weights (never commit binaries)
models/*.pt
models/*.onnx
models/*.bin
models/*.engine
models/**/*.pt
models/**/*.onnx

# Runtime data
data/**
!data/.gitkeep
!data/**/.gitkeep
recordings/
*.mp4

# Environment & OS
.env
.env.*
.DS_Store
Thumbs.db

# Logs
*.log
.startup_logs/

# Experiment detection dataset: proposals are candidates, and the label tree is
# human output under review. Track the tooling and classes.json, not the pixels,
# and never let an unreviewed proposal reach git history.
dataset/experiment_detection/proposals/
dataset/experiment_detection/labels/
dataset/experiment_detection/qa/
dataset/experiment_detection/sampling/*.jpg
experiment/yolo_training/**/__pycache__/
